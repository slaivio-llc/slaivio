    "var_eb659b0a9b57": {
      "type": "variant",
      "label": "Landing V1 — Du message au dossier",
      "parentId": "var_acb9d864f5d8",
      "themeId": null,
      "rect": {
        "x": 1540,
        "y": 0,
        "w": 1440,
        "h": 0
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css');\n.f-inter{font-family:'Inter',-apple-system,'Segoe UI',sans-serif}\n.f-mono{font-family:'JetBrains Mono',ui-monospace,monospace}\n</style>\n<div class=\"f-inter bg-white text-[15px] text-[#3f4851] antialiased\" data-kid=\"1\" data-name=\"page root layout container\" style=\"overflow-x:clip\">\n    <!-- NAV -->\n    <header class=\"border-b border-[#dfe3e7] bg-white\" data-kid=\"1-1\" data-name=\"site header with bottom border\">\n        <div class=\"mx-auto flex h-16 max-w-[1200px] items-center gap-10 px-8\" data-kid=\"1-1-1\" data-name=\"header inner row container\">\n            <a class=\"flex items-center gap-2.5\" data-kid=\"1-1-1-1\" data-name=\"brand logo link\" href=\"#top\">\n                <span class=\"grid h-7 w-7 place-items-center rounded-[6px] bg-[#087a46] text-[14px] font-bold text-white\" data-kid=\"1-1-1-1-1\" data-name=\"brand monogram badge\">\n                    S\n                </span>\n                <span class=\"text-[16px] font-bold tracking-[-0.3px] text-[#15191d]\" data-kid=\"1-1-1-1-2\" data-name=\"brand wordmark text\">\n                    Slaivio\n                </span>\n            </a>\n            <nav class=\"flex items-center gap-7 text-[14px] font-medium text-[#3f4851]\" data-kid=\"1-1-1-2\" data-name=\"main horizontal navigation\">\n                <a data-kid=\"1-1-1-2-1\" data-name=\"nav link: how it works\" href=\"#comment\">\n                    Comment ça marche\n                </a>\n                <a data-kid=\"1-1-1-2-2\" data-name=\"nav link: packages and tracking\" href=\"#suivi\">\n                    Colis et suivi\n                </a>\n                <a data-kid=\"1-1-1-2-3\" data-name=\"nav link: follow-ups\" href=\"#relances\">\n                    Relances\n                </a>\n            </nav>\n            <div class=\"ml-auto flex items-center gap-5\" data-kid=\"1-1-1-3\" data-name=\"header right actions container\">\n                <a class=\"text-[14px] font-medium text-[#15191d]\" data-kid=\"1-1-1-3-1\" data-name=\"sign-in text link\" href=\"#connexion\">\n                    Se connecter\n                </a>\n                <a class=\"inline-flex h-10 items-center rounded-[8px] bg-[#087a46] px-4 text-[14px] font-semibold text-white\" data-kid=\"1-1-1-3-2\" data-name=\"header call-to-action button:false\" href=\"#demo\">\n                    Voir un dossier en démonstration\n                </a>\n            </div>\n        </div>\n    </header>\n    <!-- HERO -->\n    <section class=\"mx-auto max-w-[1200px] px-8 pt-20\" data-kid=\"1-2\" data-name=\"hero section container\" id=\"top\">\n        <div class=\"grid grid-cols-12 items-end gap-8\" data-kid=\"1-2-1\" data-name=\"hero headline and copy grid\">\n            <h1 class=\"col-span-8 text-[64px] font-bold leading-[1.02] tracking-[-2.4px] text-[#15191d]\" data-kid=\"1-2-1-1\" data-name=\"hero headline text\">\n                Une demande WhatsApp ne devrait pas rester sans dossier.\n            </h1>\n            <div class=\"col-span-4 pb-2\" data-kid=\"1-2-1-2\" data-name=\"hero supporting copy column\">\n                <p class=\"text-[16px] leading-[1.55] text-[#3f4851]\" data-kid=\"1-2-1-2-1\" data-name=\"hero descriptive paragraph\">\n                    Slaivio range chaque conversation client dans un dossier : colis, poids, prix, statut, solde. Vous voyez ce qui est connu, ce qui manque, et ce qu'il reste à faire.\n                </p>\n                <div class=\"mt-6 flex items-center gap-5\" data-kid=\"1-2-1-2-2\" data-name=\"hero actions row\">\n                    <a class=\"inline-flex h-11 items-center gap-2 rounded-[8px] bg-[#087a46] px-5 text-[14px] font-semibold text-white\" data-kid=\"1-2-1-2-2-1\" data-name=\"primary demo CTA button\" href=\"#demo\">\n                        Voir un dossier en démonstration\n                        <span class=\"text-[16px]\" data-kid=\"1-2-1-2-2-1-1\" data-name=\"arrow icon wrapper\">\n                            <i class=\"icon-arrow-right\" data-kid=\"1-2-1-2-2-1-1-1\" data-name=\"right arrow icon\">\n                            </i>\n                        </span>\n                    </a>\n                    <a class=\"text-[14px] font-semibold text-[#15191d] underline decoration-[#c9cfd5] underline-offset-4\" data-kid=\"1-2-1-2-2-2\" data-name=\"secondary tracking link\" href=\"#suivi\">\n                        Voir le suivi des colis\n                    </a>\n                </div>\n            </div>\n        </div>\n        <!-- Product composition -->\n        <div class=\"mt-14\" data-kid=\"1-2-2\" data-name=\"product composition block\">\n            <div class=\"mb-2.5 flex items-center justify-between text-[12px] text-[#69717a]\" data-kid=\"1-2-2-1\" data-name=\"composition caption bar\">\n                <span data-kid=\"1-2-2-1-1\" data-name=\"flow description label\">\n                    Messagerie → dossier · aperçu du parcours V1\n                </span>\n                <span data-kid=\"1-2-2-1-2\" data-name=\"demo data disclaimer label\">\n                    Données fictives de démonstration\n                </span>\n            </div>\n            <div class=\"grid grid-cols-[288px_1fr_392px] overflow-hidden rounded-[12px] border border-[#dfe3e7] bg-white\" data-kid=\"1-2-2-2\" data-name=\"three-panel product mockup container\">\n                <!-- Conversations -->\n                <div class=\"border-r border-[#dfe3e7] bg-[#f7f8f8]\" data-kid=\"1-2-2-2-1\" data-name=\"conversation list panel\">\n                    <div class=\"flex h-12 items-center justify-between border-b border-[#dfe3e7] px-4\" data-kid=\"1-2-2-2-1-1\" data-name=\"conversation list header\">\n                        <span class=\"text-[13px] font-semibold text-[#15191d]\" data-kid=\"1-2-2-2-1-1-1\" data-name=\"conversation list title\">\n                            Conversations\n                        </span>\n                        <span class=\"text-[12px] text-[#69717a]\" data-kid=\"1-2-2-2-1-1-2\" data-name=\"unread count badge\">\n                            6 non lues\n                        </span>\n                    </div>\n                    <ul class=\"text-[13px]\" data-kid=\"1-2-2-2-1-2\" data-name=\"conversation list\">\n                        <li class=\"border-b border-[#dfe3e7] bg-white px-4 py-3\" data-kid=\"1-2-2-2-1-2-1\" data-name=\"active conversation list item\">\n                            <div class=\"flex items-center justify-between\" data-kid=\"1-2-2-2-1-2-1-1\" data-name=\"conversation item header row\">\n                                <span class=\"font-semibold text-[#15191d]\" data-kid=\"1-2-2-2-1-2-1-1-1\" data-name=\"conversation sender name\">\n                                    Mireille Kasongo\n                                </span>\n                                <span class=\"text-[11px] text-[#69717a]\" data-kid=\"1-2-2-2-1-2-1-1-2\" data-name=\"conversation timestamp\">\n                                    09:20\n                                </span>\n                            </div>\n                            <p class=\"mt-0.5 truncate text-[12px] text-[#69717a]\" data-kid=\"1-2-2-2-1-2-1-2\" data-name=\"conversation preview text\">\n                                Vous : Les cartons partent avec l'envoi…\n                            </p>\n                            <span class=\"mt-1.5 inline-flex items-center gap-1 text-[11px] font-medium text-[#087a46]\" data-kid=\"1-2-2-2-1-2-1-3\" data-name=\"conversation status chip\">\n                                <span class=\"h-1.5 w-1.5 rounded-full bg-[#087a46]\" data-kid=\"1-2-2-2-1-2-1-3-1\" data-name=\"status dot indicator\">\n                                </span>\n                                <span class=\"f-mono\" data-kid=\"1-2-2-2-1-2-1-3-2\" data-name=\"dossier code label\">\n                                    DOS-0417\n                                </span>\n                            </span>\n                        </li>\n                        <li class=\"border-b border-[#eef0f2] px-4 py-3\" data-kid=\"1-2-2-2-1-2-2\" data-name=\"conversation list item\">\n                            <div class=\"flex items-center justify-between\" data-kid=\"1-2-2-2-1-2-2-1\" data-name=\"conversation item header row\">\n                                <span class=\"font-semibold text-[#15191d]\" data-kid=\"1-2-2-2-1-2-2-1-1\" data-name=\"conversation sender name\">\n                                    Ets. Mutombo & Fils\n                                </span>\n                                <span class=\"text-[11px] text-[#69717a]\" data-kid=\"1-2-2-2-1-2-2-1-2\" data-name=\"conversation timestamp\">\n                                    09:02\n                                </span>\n                            </div>\n                            <p class=\"mt-0.5 truncate text-[12px] text-[#3f4851]\" data-kid=\"1-2-2-2-1-2-2-2\" data-name=\"conversation preview text\">\n                                Le conteneur maritime est-il arrivé à Matadi ?\n                            </p>\n                            <span class=\"mt-1.5 inline-flex items-center gap-1 text-[11px] font-medium text-[#087a46]\" data-kid=\"1-2-2-2-1-2-2-3\" data-name=\"conversation status chip\">\n                                <span class=\"h-1.5 w-1.5 rounded-full bg-[#087a46]\" data-kid=\"1-2-2-2-1-2-2-3-1\" data-name=\"status dot indicator\">\n                                </span>\n                                <span class=\"f-mono\" data-kid=\"1-2-2-2-1-2-2-3-2\" data-name=\"dossier code label\">\n                                    DOS-0398\n                                </span>\n                            </span>\n                        </li>\n                        <li class=\"bo