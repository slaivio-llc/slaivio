      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/lucide-static@1.48.0/font/lucide.css');\n.f-inter{font-family:'Inter',-apple-system,'Segoe UI',sans-serif}\n.f-mono{font-family:'JetBrains Mono',ui-monospace,monospace}\n</style>\n<div class=\"f-inter flex min-h-[1180px] w-full bg-white text-[14px] text-[#3f4851] antialiased\" data-kid=\"1\" data-name=\"app layout container\">\n    <!-- SIDEBAR -->\n    <aside class=\"flex w-[248px] shrink-0 flex-col border-r border-[#dfe3e7] bg-[#f7f8f8]\" data-kid=\"1-1\" data-name=\"sidebar navigation panel\">\n        <div class=\"flex h-14 items-center gap-2.5 border-b border-[#dfe3e7] px-4\" data-kid=\"1-1-1\" data-name=\"sidebar brand header\">\n            <div class=\"grid h-7 w-7 place-items-center rounded-[6px] bg-[#087a46] text-[14px] font-bold text-white\" data-kid=\"1-1-1-1\" data-name=\"brand logo badge\">\n                S\n            </div>\n            <span class=\"text-[15px] font-bold tracking-[-0.3px] text-[#15191d]\" data-kid=\"1-1-1-2\" data-name=\"brand name text\">\n                Slaivio\n            </span>\n            <span class=\"ml-auto text-[16px] text-[#8a929b]\" data-kid=\"1-1-1-3\" data-name=\"collapse sidebar icon button\">\n                <i class=\"icon-panel-left\" data-kid=\"1-1-1-3-1\" data-name=\"panel-left sidebar toggle icon\">\n                </i>\n            </span>\n        </div>\n        <div class=\"p-3\" data-kid=\"1-1-2\" data-name=\"sidebar agency and search block\">\n            <button class=\"flex w-full items-center gap-2.5 rounded-[8px] border border-[#dfe3e7] bg-white px-2.5 py-2 text-left\" data-kid=\"1-1-2-1\" data-name=\"current agency selector button\">\n                <div class=\"grid h-7 w-7 place-items-center rounded-[6px] bg-[#15191d] text-[11px] font-semibold text-white\" data-kid=\"1-1-2-1-1\" data-name=\"agency initials avatar badge\">\n                    KC\n                </div>\n                <div class=\"min-w-0 flex-1\" data-kid=\"1-1-2-1-2\" data-name=\"agency name and location container\">\n                    <p class=\"truncate text-[13px] font-semibold text-[#15191d]\" data-kid=\"1-1-2-1-2-1\" data-name=\"agency name text\">\n                        Kivu Cargo Express\n                    </p>\n                    <p class=\"truncate text-[11px] text-[#69717a]\" data-kid=\"1-1-2-1-2-2\" data-name=\"agency branch location text\">\n                        Agence Kinshasa · Gombe\n                    </p>\n                </div>\n                <span class=\"text-[14px] text-[#8a929b]\" data-kid=\"1-1-2-1-3\" data-name=\"agency selector dropdown chevron icon\">\n                    <i class=\"icon-chevrons-up-down\" data-kid=\"1-1-2-1-3-1\" data-name=\"chevrons-up-down selector icon\">\n                    </i>\n                </span>\n            </button>\n            <div class=\"mt-2.5 flex h-9 items-center gap-2 rounded-[8px] border border-[#dfe3e7] bg-white px-2.5 text-[13px] text-[#8a929b]\" data-kid=\"1-1-2-2\" data-name=\"global search input field\">\n                <span class=\"text-[15px]\" data-kid=\"1-1-2-2-1\" data-name=\"search icon container\">\n                    <i class=\"icon-search\" data-kid=\"1-1-2-2-1-1\" data-name=\"magnifying glass search icon\">\n                    </i>\n                </span>\n                <span class=\"flex-1\" data-kid=\"1-1-2-2-2\" data-name=\"search placeholder text\">\n                    Rechercher…\n                </span>\n                <span class=\"f-mono rounded-[4px] border border-[#dfe3e7] bg-[#f7f8f8] px-1.5 text-[11px] text-[#69717a]\" data-kid=\"1-1-2-2-3\" data-name=\"keyboard shortcut hint badge\">\n                    ⌘K\n                </span>\n            </div>\n        </div>\n        <nav class=\"flex-1 px-3 pb-3 text-[13px] font-medium\" data-kid=\"1-1-3\" data-name=\"main sidebar navigation links\">\n            <a class=\"relative flex h-9 items-center gap-2.5 rounded-[8px] border border-[#dfe3e7] bg-white px-2.5 text-[#15191d]\" data-kid=\"1-1-3-1\" data-name=\"home nav link (active)\">\n                <span class=\"absolute -left-3 top-2 h-5 w-[2px] rounded-r bg-[#087a46]\" data-kid=\"1-1-3-1-1\" data-name=\"active link green indicator bar\">\n                </span>\n                <span class=\"text-[17px] text-[#087a46]\" data-kid=\"1-1-3-1-2\" data-name=\"home nav icon wrapper\">\n                    <i class=\"icon-house\" data-kid=\"1-1-3-1-2-1\" data-name=\"house home icon\">\n                    </i>\n                </span>\n                Accueil\n            </a>\n            <p class=\"mt-5 mb-1.5 px-2.5 text-[11px] font-semibold uppercase tracking-[1.2px] text-[#8a929b]\" data-kid=\"1-1-3-2\" data-name=\"operations nav section label\">\n                Opérations\n            </p>\n            <a class=\"flex h-9 items-center gap-2.5 rounded-[8px] px-2.5 text-[#3f4851]\" data-kid=\"1-1-3-3\" data-name=\"packages nav link\">\n                <span class=\"text-[17px] text-[#69717a]\" data-kid=\"1-1-3-3-1\" data-name=\"packages icon wrapper\">\n                    <i class=\"icon-package\" data-kid=\"1-1-3-3-1-1\" data-name=\"package icon\">\n                    </i>\n                </span>\n                Colis\n                <span class=\"f-mono ml-auto text-[11px] text-[#8a929b]\" data-kid=\"1-1-3-3-2\" data-name=\"packages count badge\">\n                    1 284\n                </span>\n            </a>\n            <a class=\"flex h-9 items-center gap-2.5 rounded-[8px] px-2.5 text-[#3f4851]\" data-kid=\"1-1-3-4\" data-name=\"shipments nav link\">\n                <span class=\"text-[17px] text-[#69717a]\" data-kid=\"1-1-3-4-1\" data-name=\"shipments icon wrapper\">\n                    <i class=\"icon-ship\" data-kid=\"1-1-3-4-1-1\" data-name=\"ship icon\">\n                    </i>\n                </span>\n                Expéditions\n                <span class=\"f-mono ml-auto text-[11px] text-[#8a929b]\" data-kid=\"1-1-3-4-2\" data-name=\"shipments count badge\">\n                    18\n                </span>\n            </a>\n            <a class=\"flex h-9 items-center gap-2.5 rounded-[8px] px-2.5 text-[#3f4851]\" data-kid=\"1-1-3-5\" data-name=\"warehouses nav link\">\n                <span class=\"text-[17px] text-[#69717a]\" data-kid=\"1-1-3-5-1\" data-name=\"warehouses icon wrapper\">\n                    <i class=\"icon-warehouse\" data-kid=\"1-1-3-5-1-1\" data-name=\"warehouse icon\">\n                    </i>\n                </span>\n                Entrepôts\n            </a>\n            <a class=\"flex h-9 items-center gap-2.5 rounded-[8px] px-2.5 text-[#3f4851]\" data-kid=\"1-1-3-6\" data-name=\"pickups nav link\">\n                <span class=\"text-[17px] text-[#69717a]\" data-kid=\"1-1-3-6-1\" data-name=\"pickups icon wrapper\">\n                    <i class=\"icon-package-check\" data-kid=\"1-1-3-6-1-1\" data-name=\"package-check pickup icon\">\n                    </i>\n                </span>\n                Retraits\n                <span class=\"ml-auto rounded-full bg-[#fef3e2] px-1.5 text-[11px] font-semibold text-[#b45309]\" data-kid=\"1-1-3-6-2\" data-name=\"pickups pending count badge\">\n                    12\n                </span>\n            </a>\n            <a class=\"flex h-9 items-center gap-2.5 rounded-[8px] px-2.5 text-[#3f4851]\" data-kid=\"1-1-3-7\" data-name=\"tracking nav link\">\n                <span class=\"text-[17px] text-[#69717a]\" data-kid=\"1-1-3-7-1\" data-name=\"tracking icon wrapper\">\n                    <i class=\"icon-radar\" data-kid=\"1-1-3-7-1-1\" data-name=\"radar tracking icon\">\n                    </i>\n                </span>\n                Suivi\n            </a>\n            <p class=\"mt-5 mb-1.5 px-2.5 text-[11px] font-semibold uppercase tracking-[1.2px] text-[#8a929b]\" data-kid=\"1-1-3-8\" data-name=\"client relations nav section label\">\n                Relation client\n            </p>\n            <a class=\"flex h-9 items-center gap-2.5 rounded-[8px] px-2.5 text-[#3f4851]\" data-kid=\"1-1-3-9\" data-name=\"clients nav link\">\n                <span class=\"text-[17px] text-[#69717a]\" data-kid=\"1-1-3-9-1\" data-name=\"clients icon wrapper\">\n                    <i class=\"icon-users\" data-kid=\"1-1-3-9-1-1\" data-name=\"users icon\">\n                    </i>\n                </span>\n                Clients\n            </a>\n            <a class=\"flex h-9 items-center gap-2.5 rounded-[8px] px-2.5 text-[#3f4851]\" data-kid=\"1-1-3-10\" data-name=\"messaging nav link\">\n                <span class=\"text-[17px] text-[#69717a]\" data-kid=\"1-1-3-10-1\" data-name=\"messaging icon wrapper\">\n                    <i class=\"icon-message-square\" data-kid=\"1-1-3-10-1-1\" data-name=\"message-square chat icon\">\n                    </i>\n                </span>\n                Messagerie\n                <span class=\"ml-auto rounded-full bg-[#087a46] px-1.5 text-[11px] font-semibold text-white\" data-kid=\"1-1-3-10-2\" data-name=\"unread messages count badge\">\n                    7\n                </span>\n            </a>\n            <p class=\"mt-5 mb-1.5 px-2.5 text-[11px] font-semibold uppercase tracking-[1.2px] text-[#8a929b]\" data-kid=\"1-1-3-11\" data-name=\"management nav section label\">\n                Gestion\n            </p>\n            <a class=\"flex h-9 items-center gap-2.5 rounded-[8px] px-2.5 text-[#3f4851]\" data-kid=\"1-1-3-12\" data-name=\"finance nav link\">\n                <span class=\"text-[17px] text-[#69717a]\" data-kid=\"1-1-3-12-1\" data-name=\"finance icon wrapper\">\n                    <i class=\"icon-wallet\" data-kid=\"1-1-3-12-1-1\" data-name=\"wallet finance icon\">\n                    </i>\n                </span>\n                Finance\n            </a>\n            <a class=\"flex h-9 items-center gap-2.5 rounded-[8px] px-2.5 text-[#3f4851]\" data-kid=\"1-1-3-13\" data-name=\"pricing nav link\">\n                <span class=\"text-[17px] text-[#69717a]\" data-kid=\"1-1-3-13-1\" data-name=\"pricing icon wrapper\">\n                    <i class=\"icon-tag\" data-kid=\"1-1-3-13-1-1\" data-name=\"tag pricing icon\">\n                    </i>\n                </span>\n                Tarifs\n            </a>\n            <div class=\"my-4 h-px bg-[#dfe3e7]\" data-kid=\"1-1-3-14\" data-name=\"navigation divider line\">\n            </div>\n            <a class=\"flex h-9 items-center gap-2.5 rounded-[8px] px-2.5 text-[#3f4851]\" data-kid=\"1-1-3-15\" data-name=\"settings nav link\">\n                <span class=\"text-[17px] text-[#69717a]\" data-kid=\"1-1-3-15-1\" data-name=\"settings icon wrapper\">\n                    <i class=\"icon-settings\" data-kid=\"1-1-3-15-1-1\" data-name=\"gear settings icon\">\n                    </i>\n                </span>\n                Paramètres\n            </a>\n        </nav>\n        <div class=\"border-t border-[#dfe3e7] p-3\" data-kid=\"1-1-4\" data-name=\"sidebar footer user card\">\n            <div class=\"mb-3 flex items-center gap-2 px-1 text-[11px] text-[#69717a]\" data-kid=\"1-1-4-1\" data-name=\"system status indicator row\">\n                <span class=\"h-1.5 w-1.5 rounded-full bg-[#12c76f]\" data-kid=\"1-1-4-1-1\" data-name=\"critical status indicator dot\">\n                </span>\n                Tous les services opérationnels\n            </div>\n            <div class=\"flex items-center gap-2.5 px-1\" data-kid=\"1-1-4-2\" data-name=\"user identity container\">\n                <img alt=\"Grâce Mbuyi\" class=\"h-8 w-8 rounded-full border border-[#dfe3e7] object-cover\" data-kid=\"1-1-4-2-1\" data-name=\"user avatar image\" decoding=\"async\" loading=\"lazy\" src=\"https://i.pravatar.cc/64?u=grace-mbuyi\"/>\n                <div class=\"min-w-0 flex-1\" data-kid=\"1-1-4-2-2\" data-name=\"user name and role container\">\n                    <p class=\"truncate text-[13px] font-semibold text-[#15191d]\" data-kid=\"1-1-4-2-2-1\" data-name=\"user full name text\">\n                        Grâce Mbuyi\n                    </p>\n                    <p class=\"truncate text-[11px] text-[#69717a]\" data-kid=\"1-1-4-2-2-2\" data-name=\"user role text\">\n                        Gérante d'agence\n                    </p>\n                </div>\n                <span class=\"text-[15px] text-[#8a929b]\" data-kid=\"1-1-4-2-3\" data-name=\"user menu ellipsis icon button\">\n                    <i class=\"icon-ellipsis\" data-kid=\"1-1-4-2-3-1\" data-name=\"ellipsis three-dot icon\">\n                    </i>\n                </span>\n            </div>\n        </div>\n    </aside>\n    <!-- MAIN -->\n    <main class=\"min-w-0 flex-1\" data-kid=\"1-2\" data-name=\"main content area\">\n        <!-- TOPBAR -->\n        <header class=\"flex h-14 items-center gap-3 border-b border-[#dfe3e7] bg-white px-8\" data-kid=\"1-2-1\" data-name=\"top action bar\">\n            <div class=\"flex items-center gap-1.5 text-[13px]\" data-kid=\"1-2-1-1\" data-name=\"breadcrumb trail container\">\n                <span class=\"text-[#69717a]\" data-kid=\"1-2-1-1-1\" data-name=\"breadcrumb agency name text\">\n                    Kivu Cargo Express\n                </span>\n                <span class=\"text-[13px] text-[#c9cfd5]\" data-kid=\"1-2-1-1-2\" data-name=\"breadcrumb separator chevron icon\">\n                    <i class=\"icon-chevron-right\" data-kid=\"1-2-1-1-2-1\" data-name=\"chevron-right separator icon\">\n                    </i>\n                </span>\n                <span class=\"font-medium text-[#15191d]\" data-kid=\"1-2-1-1-3\" data-name=\"breadcrumb current page text\">\n                    Accueil\n                </span>\n            </div>\n            <div class=\"ml-auto flex items-center gap-2\" data-kid=\"1-2-1-2\" data-name=\"top bar actions group\">\n                <button class=\"inline-flex h-9 items-center gap-1.5 rounded-[8px] border border-[#dfe3e7] bg-white px-3 text-[13px] font-semibold text-[#15191d]\" data-kid=\"1-2-1-2-1\" data-name=\"new package action button\">\n                    <span class=\"text-[15px]\" data-kid=\"1-2-1-2-1-1\" data-name=\"new package icon container\">\n                        <i class=\"icon-package-plus\" data-kid=\"1-2-1-2-1-1-1\" data-name=\"package-plus add icon\">\n                        </i>\n                    </span>\n                    Nouveau colis\n                </button>\n                <button class=\"inline-flex h-9 items-center gap-1.5 rounded-[8px] bg-[#087a46] px-3.5 text-[13px] font-semibold text-white\" data-kid=\"1-2-1-2-2\" data-name=\"new shipment primary button\">\n                    <span class=\"text-[15px]\" data-kid=\"1-2-1-2-2-1\" data-name=\"new shipment icon container\">\n                        <i class=\"icon-plus\" data-kid=\"1-2-1-2-2-1-1\" data-name=\"plus add icon\">\n                        </i>\n                    </span>\n                    Nouvelle expédition\n                </button>\n                <div class=\"mx-1 h-5 w-px bg-[#dfe3e7]\" data-kid=\"1-2-1-2-3\" data-name=\"action group divider line\">\n                </div>\n                <button class=\"relative grid h-9 w-9 place-items-center rounded-[8px] text-[17px] text-[#3f4851]\" data-kid=\"1-2-1-2-4\" data-name=\"notifications bell button\">\n                    <i class=\"icon-bell\" data-kid=\"1-2-1-2-4-1\" data-name=\"bell notification icon\">\n                    </i>\n                    <span class=\"absolute right-2 top-2 h-1.5 w-1.5 rounded-full bg-[#c62828]\" data-kid=\"1-2-1-2-4-2\" data-name=\"notification red alert dot\">\n                    </span>\n                </button>\n                <button class=\"grid h-9 w-9 place-items-center rounded-[8px] text-[17px] text-[#3f4851]\" data-kid=\"1-2-1-2-5\" data-name=\"help button\">\n                    <i class=\"icon-circle-help\" data-kid=\"1-2-1-2-5-1\" data-name=\"circle-help question mark icon\">\n                    </i>\n                </button>\n            </div>\n        </header>\n        <div class=\"mx-auto max-w-[1192px] px-8 py-7\" data-kid=\"1-2-2\" data-name=\"dashboard content wrapper\">\n            <!-- PAGE HEADER -->\n            <div class=\"flex items-end justify-between gap-6\" data-kid=\"1-2-2-1\" data-name=\"page header bar\">\n                <div data-kid=\"1-2-2-1-1\" data-name=\"page title area\">\n                    <p class=\"text-[11px] font-semibold uppercase tracking-[1.2px] text-[#087a46]\" data-kid=\"1-2-2-1-1-1\" data-name=\"page section subtitle label\">\n                        Tableau de bord\n                    </p>\n                    <h1 class=\"mt-1.5 text-[28px] font-bold leading-[1.15] tracking-[-0.9px] text-[#15191d]\" data-kid=\"1-2-2-1-1-2\" data-name=\"dashboard welcome headline\">\n                        Bonjour Grâce, 3 points demandent votre attention.\n                    </h1>\n                    <p class=\"mt-1.5 text-[13px] text-[#69717a]\" data-kid=\"1-2-2-1-1-3\" data-name=\"page date and last update caption\">\n                        Jeudi 16 octobre 2026 · Données mises à jour il y a 2 min\n                    </p>\n                </div>\n                <div class=\"flex items-center gap-2\" data-kid=\"1-2-2-1-2\" data-name=\"date range and export controls\">\n                    <div class=\"flex h-9 items-center rounded-[8px] border border-[#dfe3e7] bg-[#f7f8f8] p-0.5 text-[13px] font-medium\" data-kid=\"1-2-2-1-2-1\" data-name=\"date range segmented toggle\">\n                        <span class=\"rounded-[6px] px-3 py-1.5 text-[#69717a]\" data-kid=\"1-2-2-1-2-1-1\" data-name=\"seven day range option\">\n                            7 j\n                        </span>\n                        <span class=\"rounded-[6px] border border-[#dfe3e7] bg-white px-3 py-1.5 text-[#15191d]\" data-kid=\"1-2-2-1-2-1-2\" data-name=\"thirty day range option (selected)\">\n                            30 j\n                        </span>\n                        <span class=\"rounded-[6px] px-3 py-1.5 text-[#69717a]\" data-kid=\"1-2-2-1-2-1-3\" data-name=\"quarter range option\">\n                            Trimestre\n                        </span>\n                    </div>\n                    <button class=\"inline-flex h-9 items-center gap-1.5 rounded-[8px] border border-[#dfe3e7] bg-white px-3 text-[13px] font-semibold text-[#15191d]\" data-kid=\"1-2-2-1-2-2\" data-name=\"export data button\">\n                        <span class=\"text-[15px]\" data-kid=\"1-2-2-1-2-2-1\" data-name=\"export icon container\">\n                            <i class=\"icon-download\" data-kid=\"1-2-2-1-2-2-1-1\" data-name=\"download cloud arrow icon\">\n                            </i>\n                        </span>\n                        Exporter\n                    </button>\n                </div>\n            </div>\n            <!-- KPI BAND -->\n            <section class=\"mt-6 grid grid-cols-5 divide-x divide-[#dfe3e7] rounded-[12px] border border-[#dfe3e7] bg-white\" data-kid=\"1-2-2-2\" data-name=\"key metrics band container\">\n                <div class=\"p-5\" data-kid=\"1-2-2-2-1\" data-name=\"packages received KPI card\">\n                    <p class=\"text-[12px] font-medium text-[#69717a]\" data-kid=\"1-2-2-2-1-1\" data-name=\"KPI label text\">\n                        Colis reçus\n                    </p>\n                    <p class=\"mt-2 text-[30px] font-bold leading-none tracking-[-1.2px] text-[#15191d] tabular-nums\" data-kid=\"1-2-2-2-1-2\" data-name=\"KPI value number\">\n                        2 846\n                    </p>\n                    <div class=\"mt-3 flex items-center justify-between\" data-kid=\"1-2-2-2-1-3\" data-name=\"KPI trend row\">\n                        <span class=\"text-[12px] font-semibold text-[#087a46] tabular-nums\" data-kid=\"1-2-2-2-1-3-1\" data-name=\"green positive trend percent\">\n                            +12,4 %\n                        </span>\n                        <svg data-kid=\"1-2-2-2-1-3-2\" data-name=\"sparkline chart icon\" height=\"22\" viewbox=\"0 0 72 22\" width=\"72\">\n                            <polyline fill=\"none\" points=\"0,18 9,15 18,16 27,11 36,13 45,8 54,9 63,5 72,3\" stroke=\"#12c76f\" stroke-width=\"1.5\">\n                            </polyline>\n                        </svg>\n                    </div>\n                </div>\n                <div class=\"p-5\" data-kid=\"1-2-2-2-2\" data-name=\"shipments in transit KPI card\">\n                    <p class=\"text-[12px] font-medium text-[#69717a]\" data-kid=\"1-2-2-2-2-1\" data-name=\"KPI label text\">\n                        Expéditions en transit\n                    </p>\n                    <p class=\"mt-2 text-[30px] font-bold leading-none tracking-[-1.2px] text-[#15191d] tabular-nums\" data-kid=\"1-2-2-2-2-2\" data-name=\"KPI value number\">\n                        18\n                    </p>\n                    <div class=\"mt-3 flex items-center justify-between\" data-kid=\"1-2-2-2-2-3\" data-name=\"KPI trend row\">\n                        <span class=\"text-[12px] font-medium text-[#69717a]\" data-kid=\"1-2-2-2-2-3-1\" data-name=\"mode mix breakdown text\">\n                            6 aérien · 12 maritime\n                        </span>\n                    </div>\n                </div>\n                <div class=\"p-5\" data-kid=\"1-2-2-2-3\" data-name=\"pickups ready KPI card\">\n                    <p class=\"text-[12px] font-medium text-[#69717a]\" data-kid=\"1-2-2-2-3-1\" data-name=\"KPI label text\">\n                        Prêts au retrait\n                    </p>\n                    <p class=\"mt-2 text-[30px] font-bold leading-none tracking-[-1.2px] text-[#15191d] tabular-nums\" data-kid=\"1-2-2-2-3-2\" data-name=\"KPI value number\">\n              